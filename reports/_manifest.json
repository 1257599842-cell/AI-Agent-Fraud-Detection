 "reports/eval_runs/r1/anchor_blind.md": {
  "sha256": "ec99b8501f2ef7305e9b6468d4600099f407f579e70387753dfde001def10312",
  "frozen_at": "2026-07-27",
  "tier": "frozen",
  "why": "盲标表：标注者当时未看 judge 结果。重生成会带入现在的认知，**毁掉盲态**——而盲态正是 judge-人工一致率这个数的全部效力来源。"
 },
 "reports/eval_runs/r1/anchor_enrich.md": {
  "sha256": "ba0e03a57d501dd6ea9b1359b85920d38d19c5a3ceab7f715842ef2187e65c76",
  "frozen_at": "2026-07-28",
  "tier": "frozen",
  "why": "富集盲标表：用于算 judge-flag 精确率。重生成会让「独立盲标」不再独立。"
 },
 "reports/eval_runs/r1/anchor_v2.md": {
  "sha256": "ed86cbad7e632e2de8dc109b6286e3a55cf5ca4a134c0f8ea4ee00352f8b3603",
  "frozen_at": "2026-07-31",
  "tier": "frozen",
  "why": "round3 缩表盲标：条目所属臂被刻意隐藏。重生成即等于先看了分组，手会对某些条目更紧、对另一些更松，把要测的东西污染掉。"
 },
 "reports/eval_runs/r1/anchor_v2_manifest.json": {
  "sha256": "b479b7f17b9bae6031b61c328f377146a2d880cbe1c420379bb01ea2c5920841",
  "frozen_at": "2026-07-30",
  "tier": "frozen",
  "why": "上表的分臂对照：**标注前打开它就废了那张表**。与 anchor_v2.md 是一对，必须同冻，否则冻了表却漏了答案。"
 },
 "reports/eval_runs/round2_rubric_draft.md": {
  "sha256": "d8f8efa588007bffdec527925e223da35c616775ae0edfbe301075b481ff029c",
  "frozen_at": "2026-07-29",
  "tier": "frozen",
  "why": "评分前的 rubric 草案：它证明「评分标准先于评分确定」。事后重写 rubric 再宣布分数，是最典型的移动球门。"
 },
 "reports/kaggle_submission.md": {
  "sha256": "2c8c9c6fb53b835b195df6bdfb77542ca9075835c2951daaf25c788dd4798155",
  "frozen_at": "2026-08-01",
  "tier": "frozen",
  "why": "记录一次**已发生的外部提交**（提交号 55152570 / 2026-08-01）。重跑 `--submit` 会向 Kaggle 真的再交一次，而旧那次的榜单快照无法重建——它是事件记录，不是可重算的产物。"
 },
 "reports/round4_preregistration.md": {
  "sha256": "135ee04e0232000880d90c381c2b953526269f98b984189f1e7e5c78fadf7797",
  "frozen_at": "2026-07-31",
  "tier": "frozen",
  "why": "预注册件：指标在跑之前写死。重写它 = 事后按结果改指标，整个「预注册」的证明力当场归零。"
 },
